# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth
SECRET=replace_with_random_secret
NEXTAUTH_SECRET=replace_with_random_secret
NEXTAUTH_URL=http://localhost:3000

# Admin Login
ADMIN_PANEL_PATH=/admin
NEXT_PUBLIC_ADMIN_PANEL_PATH=/admin
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=
ADMIN_LOGIN_PASSWORD_HASH=

# Admin OTP (Resend)
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_ADMIN_FROM_EMAIL=no-reply@example.com
RESEND_CLIENT_FROM_EMAIL=hello@example.com
RESEND_REPLY_TO_EMAIL=support@example.com
ADMIN_OTP_LENGTH=6
ADMIN_OTP_EXPIRES_MINUTES=5
ADMIN_OTP_MAX_VERIFY_ATTEMPTS=5
ADMIN_OTP_LOGIN_LOCK_MINUTES=15
ADMIN_OTP_RESEND_COOLDOWN_SECONDS=60

